---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  photo?: ImageMetadata;
  photoAlt?: string;
}
const { name, photo, photoAlt } = Astro.props;

const initials = name
  .split(' ')
  .map((part) => part[0])
  .filter(Boolean)
  .slice(0, 2)
  .join('')
  .toUpperCase();
---

{
  photo ? (
    <Image
      src={photo}
      alt={photoAlt ?? name}
      width={160}
      height={160}
      class="h-24 w-24 rounded-full object-cover"
    />
  ) : (
    <div
      class="flex h-24 w-24 items-center justify-center rounded-full bg-powai font-display text-2xl font-semibold text-linen"
      aria-hidden="true"
    >
      {initials}
    </div>
  )
}
