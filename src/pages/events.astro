---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionEyebrow from '../components/SectionEyebrow.astro';
import EventCard from '../components/EventCard.astro';
import CTAButton from '../components/CTAButton.astro';
import { chapterEventsUrl } from '../data/site';

const events = (await getCollection('events', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Dates are stored as UTC midnight, so group by UTC year.
const byYear = new Map<number, typeof events>();
for (const event of events) {
  const year = event.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), event]);
}
---

<BaseLayout title="Events" description="Every event from the IITBHF Boston chapter, newest first.">
  <section class="mx-auto max-w-5xl px-4 py-12">
    <SectionEyebrow label="Events" />
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-prose text-ink">
      Everything the chapter has hosted, newest first. For photos and write-ups, visit the Boston chapter events page at iitbombay.org.
      </p>
      <div class="shrink-0">
        <CTAButton href={chapterEventsUrl} variant="ink-outline">Go to iitbombay.org</CTAButton>
      </div>
    </div>
  </section>

  {
    [...byYear].map(([year, yearEvents]) => (
      <section class="mx-auto max-w-5xl px-4 pb-12 sm:grid sm:grid-cols-[7rem_1fr] sm:gap-8" aria-labelledby={`year-${year}`}>
        <h2
          id={`year-${year}`}
          class="mb-4 border-t border-crest pt-3 font-display text-4xl font-bold text-ink sm:sticky sm:top-6 sm:mb-0 sm:self-start"
        >
          {year}
        </h2>
        <ol class="grid gap-6">
          {yearEvents.map((event) => (
            <li>
              <EventCard
                title={event.data.title}
                date={event.data.date}
                datePrecision={event.data.datePrecision}
                location={event.data.location}
                summary={event.data.summary}
                coHosts={event.data.coHosts}
                rsvpUrl={event.data.rsvpUrl}
              />
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</BaseLayout>
